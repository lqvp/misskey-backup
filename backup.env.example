# misskey-backup 設定ファイル
# このファイルを backup.env としてコピーし、値を設定してください。
# 未設定の項目はスクリプトのデフォルト値が使われます。

# PostgreSQL
DB_USER="user"
DB_NAME="misskey"

# pg_dump を実行する Docker コンテナ名 (docker compose ps で確認)
DOCKER_CONTAINER_NAME="misskey-db-1"

# バックアップ保存先ディレクトリ
BACKUP_DIR="/home/misskey/backup"

# 世代管理: この日数より古いバックアップを削除
RETENTION_DAYS=14

# ダンプを gzip 圧縮する場合は 1、しない場合は 0
COMPRESS_DUMP=1

# Misskey インスタンスの URL と API トークン
# 空文字列にすると該当する通知をスキップします
MISSKEY_INSTANCE="https://example.com"
MISSKEY_TOKEN="your_misskey_token"

# Discord Webhook URL（空文字列でスキップ）
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/xxxx/xxxx"

# Google Drive アップロード設定
# glotlabs/gdrive (https://github.com/glotlabs/gdrive) のバイナリパス
GDRIVE_PATH="/usr/local/bin/gdrive"
GDRIVE_PARENT_ID="your_drive_folder_id"
